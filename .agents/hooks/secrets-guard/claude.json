{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "git -c \"alias.agent-hook=!bash .agents/hooks/secrets-guard/guard.sh\" agent-hook --claude; exit $LASTEXITCODE"
          }
        ]
      }
    ]
  }
}
